# 服务端配置模板：复制为 .env.local 或用 shell / systemd EnvironmentFile 注入。
# 注意：程序本身不读 .env 文件，这里只是「有哪些变量」的清单（见 internal/config/config.go）。

# 监听地址
XMF_ADDR=:8080

# SQLite 路径（相对工作目录，即 server/ 下）
XMF_DB=data/xmf.db

# 管理后台静态目录；为空则不托管 /ui/
# 生产：先把 web 构建到 web/dist，再从这里指过去
XMF_WEB=../web/dist

# JWT 签名密钥；留空则自动生成并持久化到 data/.jwt_secret（0600）
# 生产建议显式设置（多实例部署时必须一致）
XMF_JWT_SECRET=

# 开发登录后门（POST /api/v1/user/auth/dev_login）：生产必须设为 0
XMF_DEV_LOGIN=1

# 微信小程序登录；未配置时只能用开发登录
XMF_WX_APPID=
XMF_WX_SECRET=

# AI 生图（默认腾讯混元）。留空 = Mock 供应商（生成占位图，链路可走通）
# 也可以不配环境变量，改在后台「AI 配置」页保存：configs.ai_api_key 优先于环境变量
XMF_AI_API_KEY=
XMF_AI_SECRET_ID=
XMF_AI_BASE_URL=https://tokenhub.tencentmaas.com
XMF_AI_MODEL=hy-image-v3.5-preview
XMF_AI_STYLE=messages
