.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}
.tip {
  color: #999;
  font-size: 26rpx;
}
.btn {
  margin-top: 32rpx;
  background: #ff7ea0;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 0 48rpx;
}
.btn::after {
  border: none;
}
