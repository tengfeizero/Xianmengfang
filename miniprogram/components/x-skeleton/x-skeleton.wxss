.sk {
  padding: 24rpx 32rpx;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.gcard {
  width: 339rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 16rpx;
}
.gcover {
  width: 100%;
  height: 380rpx;
  border-radius: 24rpx;
}
.line {
  height: 24rpx;
  border-radius: 8rpx;
  margin-top: 16rpx;
}
.w90 {
  width: 90%;
}
.w70 {
  width: 70%;
}
.w60 {
  width: 60%;
}
.w45 {
  width: 45%;
}
.w40 {
  width: 40%;
}
.big {
  background: #fff;
  border-radius: 32rpx;
  padding: 24rpx;
}
.big-img {
  width: 100%;
  height: 460rpx;
  border-radius: 24rpx;
}
.row-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}
