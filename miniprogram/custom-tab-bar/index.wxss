.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(24rpx);
  border-top: 1rpx solid rgba(26, 26, 29, 0.06);
}
.bar {
  display: flex;
  align-items: flex-start;
  height: 110rpx;
  padding-top: 12rpx;
}
.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  transition: transform 0.18s ease;
}
.ic {
  width: 44rpx;
  height: 44rpx;
}
.label {
  font-size: 20rpx;
  line-height: 1.2;
  color: #9a99a2;
  transition: color 0.2s ease;
}
.item.on .label {
  color: #d92c47;
  font-weight: 600;
}
.press {
  transform: scale(0.92);
}
.item.mid {
  justify-content: flex-start;
}
.mid-btn {
  width: 92rpx;
  height: 92rpx;
  margin-top: -34rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b7d 0%, #f2455f 52%, #d92c47 100%);
  box-shadow: 0 14rpx 26rpx rgba(242, 69, 95, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid #fff;
  transition: transform 0.22s cubic-bezier(0.22, 0.68, 0, 1), box-shadow 0.22s ease;
}
.mid-on {
  transform: translateY(-4rpx) scale(1.04);
  box-shadow: 0 18rpx 32rpx rgba(242, 69, 95, 0.42);
}
.mid-ic {
  width: 46rpx;
  height: 46rpx;
}
.mid-label {
  margin-top: 6rpx;
  color: #d92c47;
  font-weight: 600;
}
