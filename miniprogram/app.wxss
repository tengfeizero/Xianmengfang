/* 现梦坊 · 小程序设计系统 v2.2
 * 基调：中性浅灰画布 + 主题红渐变品牌色（对齐后台 #f2455f），
 * 大圆角卡片 + 轻投影，动效克制。页面只用这里的变量与原子类。
 */
page {
  --bg: #f7f6f7;
  --bg-2: #fbfafb;
  --surface: #ffffff;
  --ink: #1a1a1d;
  --ink-2: #5c5b62;
  --ink-3: #9a99a2;
  --ink-4: #c5c4cb;
  --line: #eeedef;
  --brand: #f2455f;
  --brand-ink: #d92c47;
  --brand-soft: #fff1f3;
  --pink: #ff6fa5;
  --pink-soft: #ffeef4;
  --gold: #f5a623;
  --gold-soft: #fff6e4;
  --green: #14b8a6;
  --red: #e0362f;
  --grad: linear-gradient(135deg, #ff6b7d 0%, #f2455f 52%, #d92c47 100%);
  --grad-soft: linear-gradient(135deg, #fff3f4 0%, #ffe9ee 100%);
  --r-xl: 40rpx;
  --r-lg: 32rpx;
  --r-md: 24rpx;
  --r-sm: 16rpx;
  --sh-1: 0 8rpx 24rpx rgba(26, 26, 29, 0.05);
  --sh-2: 0 18rpx 44rpx rgba(26, 26, 29, 0.1);
  --sh-brand: 0 16rpx 32rpx rgba(242, 69, 95, 0.26);

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image,
scroll-view,
button,
input,
textarea,
slider {
  box-sizing: border-box;
}

/* ---------- 布局 ---------- */
.page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}
/* tab 页：给自定义 tabBar 留白 */
.page-tab {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}
/* 底部有固定操作条的页面 */
.page-bar {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}
.pad {
  padding: 0 32rpx;
}
.row {
  display: flex;
  align-items: center;
}
.col {
  display: flex;
  flex-direction: column;
}
.between {
  justify-content: space-between;
}
.center {
  align-items: center;
  justify-content: center;
}
.grow {
  flex: 1;
  min-width: 0;
}
.wrap {
  flex-wrap: wrap;
}
.g8 {
  gap: 8rpx;
}
.g12 {
  gap: 12rpx;
}
.g16 {
  gap: 16rpx;
}
.g20 {
  gap: 20rpx;
}
.g24 {
  gap: 24rpx;
}
.mt8 {
  margin-top: 8rpx;
}
.mt16 {
  margin-top: 16rpx;
}
.mt24 {
  margin-top: 24rpx;
}
.mt32 {
  margin-top: 32rpx;
}

/* ---------- 文字 ---------- */
.h1 {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.24;
}
.h2 {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}
.h3 {
  font-size: 30rpx;
  font-weight: 600;
}
.body {
  font-size: 28rpx;
  color: var(--ink);
}
.sub {
  font-size: 26rpx;
  color: var(--ink-2);
}
.cap {
  font-size: 22rpx;
  color: var(--ink-3);
}
.strong {
  font-weight: 600;
}
.muted {
  color: var(--ink-3);
  font-size: 24rpx;
}
.brand-text {
  color: var(--brand-ink);
}
.num {
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}
.ell {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ell2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--surface);
  border-radius: var(--r-lg);
  padding: 32rpx;
  box-shadow: var(--sh-1);
}
.card-tight {
  padding: 24rpx;
}
.card-glass {
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(20rpx);
}
.hr {
  height: 2rpx;
  background: var(--line);
  margin: 24rpx 0;
}

/* ---------- 按钮 ---------- */
.btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 88rpx;
  padding: 0 40rpx;
  margin: 0;
  border: none;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
  background: var(--surface);
  color: var(--ink);
  transition: transform 0.18s ease, opacity 0.18s ease, box-shadow 0.18s ease;
}
.btn::after {
  border: none;
}
.btn-primary {
  background: var(--grad);
  color: #fff;
  box-shadow: var(--sh-brand);
}
.btn-dark {
  background: var(--ink);
  color: #fff;
}
.btn-soft {
  background: var(--brand-soft);
  color: var(--brand-ink);
}
.btn-ghost {
  background: var(--surface);
  color: var(--ink-2);
  border: 2rpx solid var(--line);
}
.btn-sm {
  height: 64rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.btn-xs {
  height: 52rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.btn-lg {
  height: 96rpx;
  font-size: 32rpx;
}
.btn-block {
  width: 100%;
}
.btn[disabled] {
  opacity: 0.42;
  box-shadow: none;
}
.press {
  transform: scale(0.96);
  opacity: 0.92;
}
.press-soft {
  transform: scale(0.985);
}

/* ---------- 标签 / 芯片 ---------- */
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--ink-2);
  font-size: 25rpx;
  white-space: nowrap;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}
.chip.on {
  background: var(--ink);
  color: #fff;
  font-weight: 500;
}
.chip-brand {
  background: var(--brand-soft);
  color: var(--brand-ink);
  font-weight: 500;
}
.chip-line {
  border-color: var(--line);
}
.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 500;
}
.tag-soft {
  background: var(--brand-soft);
  color: var(--brand-ink);
}
.tag-gold {
  background: var(--gold-soft);
  color: #a86b00;
}
.tag-pink {
  background: var(--pink-soft);
  color: #d63a6a;
}
.tag-green {
  background: #e8f8f4;
  color: #0d8f81;
}

/* ---------- 价格 ---------- */
.price {
  font-weight: 700;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
.price .yuan {
  font-size: 0.66em;
  font-weight: 600;
  margin-right: 2rpx;
}
.price .unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-3);
  margin-left: 4rpx;
}
.price-origin {
  font-size: 22rpx;
  color: var(--ink-4);
  text-decoration: line-through;
  font-variant-numeric: tabular-nums;
}

/* ---------- 渐变块 / 装饰 ---------- */
.grad-block {
  background: var(--grad);
  color: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--sh-brand);
  overflow: hidden;
  position: relative;
}
.blob {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  pointer-events: none;
}
.avatar {
  border-radius: 50%;
  background: var(--brand-soft);
  flex-shrink: 0;
}
.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand-ink);
  font-weight: 600;
}

/* ---------- 分区标题 ---------- */
.sec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  margin: 44rpx 0 20rpx;
}
.sec-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}
.sec-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* ---------- 动效 ---------- */
@keyframes riseIn {
  from {
    opacity: 0;
    transform: translateY(26rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
@keyframes pop {
  0% {
    transform: scale(1);
  }
  35% {
    transform: scale(1.32);
  }
  70% {
    transform: scale(0.94);
  }
  100% {
    transform: scale(1);
  }
}
@keyframes shimmer {
  0% {
    background-position: -160% 0;
  }
  100% {
    background-position: 160% 0;
  }
}
@keyframes breathe {
  0%,
  100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-12rpx) scale(1.03);
  }
}
.rise {
  animation: riseIn 0.46s cubic-bezier(0.22, 0.68, 0, 1) both;
}
.fade {
  animation: fadeIn 0.4s ease both;
}
.d1 {
  animation-delay: 0.04s;
}
.d2 {
  animation-delay: 0.09s;
}
.d3 {
  animation-delay: 0.14s;
}
.d4 {
  animation-delay: 0.19s;
}
.d5 {
  animation-delay: 0.24s;
}
.d6 {
  animation-delay: 0.3s;
}
.pop {
  animation: pop 0.42s ease;
}
.skeleton {
  background: linear-gradient(90deg, #f2f0f1 25%, #f8f7f8 50%, #f2f0f1 75%);
  background-size: 220% 100%;
  animation: shimmer 1.3s linear infinite;
  border-radius: var(--r-sm);
}
