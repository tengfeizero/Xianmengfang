/* 订单列表 */
.tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--bg);
  white-space: nowrap;
}
.tab-row {
  display: flex;
  gap: 40rpx;
  padding: 24rpx 36rpx 16rpx;
}
.tab {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  font-size: 28rpx;
  color: var(--ink-3);
  padding-bottom: 10rpx;
  flex-shrink: 0;
  transition: color 0.2s ease;
}
.tab.on {
  color: var(--ink);
  font-weight: 700;
}
.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--grad);
}

.list {
  padding: 12rpx 32rpx 0;
}
.o-card {
  background: #fff;
  border-radius: var(--r-lg);
  padding: 28rpx;
  margin-bottom: 22rpx;
  box-shadow: var(--sh-1);
  transition: transform 0.18s ease;
}
.o-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.o-no {
  font-size: 28rpx;
  font-weight: 600;
}
.o-body {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
}
.o-thumbs {
  display: flex;
  gap: 10rpx;
}
.o-thumb {
  width: 108rpx;
  height: 108rpx;
  border-radius: var(--r-sm);
  background: #f1eef8;
}
.o-more {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
}
.o-more text {
  font-size: 22rpx;
  color: var(--ink-3);
  font-weight: 600;
}
.o-total {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  justify-content: flex-end;
  margin-top: 8rpx;
}
.o-foot {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}
