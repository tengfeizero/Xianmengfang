<view class="page">
  <!-- 状态页签 -->
  <scroll-view scroll-x class="tabs" show-scrollbar="{{false}}">
    <view class="tab-row">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab {{tabIdx === index ? 'on' : ''}}"
        data-idx="{{index}}"
        bindtap="switchTab"
      >
        <text>{{item.label}}</text>
        <view wx:if="{{tabIdx === index}}" class="tab-line"></view>
      </view>
    </view>
  </scroll-view>

  <x-skeleton wx:if="{{loading}}" type="list" count="3" />

  <x-empty
    wx:elif="{{!orders.length}}"
    icon="ticket"
    text="这个状态下还没有订单"
    desc="选一件商品，用你的作品做定制吧"
  />

  <view wx:else class="list">
    <view
      class="o-card rise {{index < 4 ? 'd' + (index + 1) : ''}}"
      wx:for="{{orders}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="detail"
      hover-class="press-soft"
    >
      <view class="o-head">
        <text class="o-no ell">{{item.firstTitle}}</text>
        <status-tag status="{{item.status}}" />
      </view>

      <view class="o-body">
        <view class="o-thumbs">
          <image
            wx:for="{{item.thumbs}}"
            wx:for-item="t"
            wx:for-index="ti"
            wx:key="*this"
            class="o-thumb"
            src="{{t}}"
            mode="aspectFill"
          />
          <view wx:if="{{item.itemCount > 2}}" class="o-thumb o-more">
            <text class="num">+{{item.itemCount - 2}}</text>
          </view>
        </view>
        <view class="col grow">
          <text class="cap">共 {{item.itemCount}} 件</text>
          <view class="o-total"><text class="cap">合计</text><view class="price"><text class="yuan">¥</text><text class="num">{{item.totalText}}</text></view></view>
        </view>
      </view>

      <view class="o-foot" wx:if="{{item.status === 'pending_accept' || item.status === 'shipped' || item.shipment}}">
        <text wx:if="{{item.shipment}}" class="cap ell grow">物流：{{item.shipment.company}} {{item.shipment.trackingNo}}</text>
        <view class="grow" wx:else></view>
        <view wx:if="{{item.status === 'pending_accept'}}" class="btn btn-ghost btn-sm" data-id="{{item.id}}" catchtap="cancel">取消订单</view>
        <view wx:if="{{item.status === 'shipped'}}" class="btn btn-primary btn-sm" data-id="{{item.id}}" catchtap="confirm">确认收货</view>
      </view>
    </view>
  </view>
</view>
