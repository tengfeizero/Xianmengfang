.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 56rpx;
}
.logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #7a5cff 0%, #ff6fa5 100%);
  color: #fff;
  font-size: 64rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-brand);
}
.h-name {
  margin-top: 28rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.h-slogan {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 4rpx;
}
.card {
  margin: 0 32rpx 22rpx;
}
.p {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--ink-2);
}
.steps {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  background: var(--bg);
  border-radius: var(--r-md);
  padding: 22rpx 8rpx;
}
.s-n {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--grad);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step text {
  font-size: 22rpx;
  color: var(--ink-2);
  white-space: nowrap;
}
.s-arrow {
  flex-shrink: 0;
}
.ver {
  text-align: center;
  padding: 24rpx 0;
}
