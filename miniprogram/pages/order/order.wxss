.row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.status {
  font-size: 34rpx;
  font-weight: 600;
}
.warn {
  color: #ff5c7a;
  margin-top: 8rpx;
}
.order-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f7f2f0;
}
.oi-left {
  flex: 1;
}
.oi-right {
  text-align: right;
}
.total-row {
  margin-top: 16rpx;
  font-weight: 600;
}
.sec-title {
  font-weight: 600;
  margin-bottom: 12rpx;
}
.confirm-btn {
  margin: 30rpx 20rpx;
}
