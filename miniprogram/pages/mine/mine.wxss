/* 我的：渐变头部 + 资产 + 订单宫格 + 服务列表 */
.mine {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}
.hero {
  margin: 24rpx 32rpx 0;
  padding: 40rpx 36rpx 32rpx;
  height: auto;
  background: linear-gradient(135deg, #7a5cff 0%, #a673ff 55%, #ff6fa5 100%);
  border-radius: var(--r-xl);
  box-shadow: var(--sh-brand);
  overflow: hidden;
}
.u-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.ava {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
}
.ava-fb {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 46rpx;
  font-weight: 700;
}
.u-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
}
.u-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}
.edit {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  color: #fff;
  font-size: 24rpx;
  transition: transform 0.18s ease;
}
.edit text {
  color: #fff;
}

/* 积分卡 */
.p-card {
  position: relative;
  z-index: 2;
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: var(--r-md);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 30rpx rgba(25, 22, 36, 0.14);
  transition: transform 0.18s ease;
}
.p-ic {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: var(--gold-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.p-num {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.1;
}
.p-t {
  font-size: 21rpx;
  color: var(--ink-3);
}
.p-rule {
  flex: 1;
  font-size: 21rpx;
  color: var(--ink-3);
  text-align: right;
  padding-right: 8rpx;
}
.p-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--gold-soft);
  color: #a86b00;
  font-size: 23rpx;
  font-weight: 600;
}

/* 资产 */
.assets {
  display: flex;
  align-items: center;
  margin: 22rpx 32rpx 0;
  padding: 28rpx 0;
  background: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--sh-1);
}
.a-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  transition: transform 0.18s ease;
}
.a-n {
  font-size: 38rpx;
  font-weight: 700;
}
.a-t {
  font-size: 22rpx;
  color: var(--ink-3);
}
.a-line {
  width: 2rpx;
  height: 52rpx;
  background: var(--line);
}

/* 面板通用 */
.panel {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--sh-1);
  padding: 28rpx;
}
.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}
.more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 订单宫格 */
.o-grid {
  display: flex;
}
.o-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: transform 0.18s ease;
}
.o-ic {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.o-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--pink);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
  border: 3rpx solid #fff;
}
.o-t {
  font-size: 23rpx;
  color: var(--ink-2);
}

/* 服务列表 */
.cell {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx 0;
  transition: transform 0.18s ease;
}
.cell + .cell {
  border-top: 2rpx solid var(--line);
}
.cell-ic {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cell-t {
  font-size: 28rpx;
}
.cell-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--pink);
  color: #fff;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 36rpx;
  text-align: center;
}

.logout {
  margin: 32rpx 32rpx 0;
  color: var(--red);
}
.ver {
  text-align: center;
  padding: 28rpx 0 8rpx;
}
