<view class="page page-tab">
  <!-- 头部 -->
  <!-- 搜索（吸顶） -->
  <view class="search-sticky">
    <view class="search" hover-class="press-soft" bindtap="goSearch">
      <x-icon name="search" size="34" color="#9a99a2" />
      <text class="search-ph">搜索作品或提示词</text>
      <view class="search-go">搜索</view>
    </view>
  </view>

  <!-- 榜单切换 -->
  <view class="filters rise d1">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="chip chip-line {{tabKey === item.key ? 'on' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchTab"
      hover-class="press-soft"
    >{{item.label}}</view>
  </view>

  <x-skeleton wx:if="{{loading}}" type="grid" count="4" />

  <x-empty
    wx:elif="{{!items.length}}"
    icon="compass"
    text="广场还没有作品"
    desc="发布你的作品，让大家看到你的灵感"
    action-text="去我的作品"
    bind:action="goWorks"
  />

  <view wx:else class="grid">
    <view
      class="wcard rise"
      wx:for="{{items}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goWork"
      hover-class="press-soft"
    >
      <view class="wcover">
        <image class="wimg" src="{{item.cover}}" mode="aspectFill" lazy-load />
        <view wx:if="{{item.isAI}}" class="wtype">AI</view>
        <view wx:if="{{item.isMine}}" class="wmine">我的</view>
      </view>
      <view class="wbody">
        <view class="wauthor">
          <image wx:if="{{item.avatar}}" class="wava" src="{{item.avatar}}" mode="aspectFill" />
          <view wx:else class="wava wava-fb">{{item.author[0]}}</view>
          <text class="wname ell">{{item.author}}</text>
        </view>
        <view class="wprompt ell2">{{item.prompt || item.typeText}}</view>
        <view class="wfoot">
          <text class="wuse">被用 {{item.useCount}} 次</text>
          <view
            class="wlike {{item.liked ? 'on' : ''}} {{item.pop ? 'pop' : ''}}"
            data-id="{{item.id}}"
            catchtap="toggleLike"
            hover-class="press"
          >
            <x-icon name="heart" size="26" color="{{item.liked ? '#ff6fa5' : '#9a99a2'}}" fill="{{item.liked}}" />
            <text class="wlike-n">{{item.likeCount}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 回到顶部 -->
  <view wx:if="{{showTop}}" class="top-fab" hover-class="press" bindtap="goTop">
    <x-icon name="up" size="40" color="#5c5b62" />
  </view>

  <view wx:if="{{items.length}}" class="more">
    <text wx:if="{{loadingMore}}">正在加载…</text>
    <text wx:elif="{{hasMore}}">上拉加载更多</text>
    <text wx:else>— 已经到底啦 —</text>
  </view>
</view>
