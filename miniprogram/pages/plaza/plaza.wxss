/* 广场：头部 + 分段榜单 + 作品瀑布卡 */
/* 搜索（与首页同款，吸顶） */
.search-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
  padding: 20rpx 0 12rpx;
  background: var(--bg);
}
.search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 0 32rpx;
  height: 84rpx;
  padding: 0 12rpx 0 28rpx;
  background: #fff;
  border-radius: 999rpx;
  box-shadow: var(--sh-1);
  transition: transform 0.18s ease;
}
.search-ph {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink-3);
}
.search-go {
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--ink);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}

/* 榜单切换（与作品页筛选同款） */
.filters {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 24rpx 32rpx 0;
}

/* 作品卡 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
  padding: 26rpx 32rpx 0;
}
.wcard {
  width: 332rpx;
  background: #fff;
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: var(--sh-1);
  transition: transform 0.18s ease;
}
.wcover {
  position: relative;
}
.wimg {
  display: block;
  width: 332rpx;
  height: 416rpx;
  background: #f2f1f3;
}
.wtype {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 107, 129, 0.92);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  letter-spacing: 1rpx;
}
.wmine {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(26, 26, 29, 0.55);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  backdrop-filter: blur(10rpx);
}
.wbody {
  padding: 20rpx 22rpx 22rpx;
}
.wauthor {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.wava {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  flex-shrink: 0;
}
.wava-fb {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--brand-ink);
  font-weight: 600;
}
.wname {
  font-size: 23rpx;
  color: var(--ink-2);
}
.wprompt {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink);
  line-height: 1.5;
  height: 72rpx;
}
.wfoot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}
.wuse {
  font-size: 21rpx;
  color: var(--ink-3);
}
.wlike {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--bg-2);
  transition: all 0.2s ease;
}
.wlike.on {
  background: var(--pink-soft);
}
.wlike-n {
  font-size: 22rpx;
  color: var(--ink-2);
  font-variant-numeric: tabular-nums;
}
.wlike.on .wlike-n {
  color: #d63a6a;
  font-weight: 600;
}

/* 回到顶部 */
.top-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(210rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-2);
  z-index: 99;
  transition: transform 0.18s ease;
}

.more {
  text-align: center;
  padding: 36rpx 0 8rpx;
  font-size: 22rpx;
  color: var(--ink-4);
}
