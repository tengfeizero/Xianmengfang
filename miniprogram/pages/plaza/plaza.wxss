/* 广场：头部 + 分段榜单 + 作品瀑布卡 */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 0;
}
.head-search {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-1);
  transition: transform 0.18s ease;
}

/* 分段控件 */
.seg {
  display: flex;
  gap: 12rpx;
  margin: 26rpx 32rpx 0;
  padding: 8rpx;
  background: #efedf5;
  border-radius: 999rpx;
}
.seg-item {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  transition: all 0.24s cubic-bezier(0.22, 0.68, 0, 1);
}
.seg-item.on {
  background: #fff;
  color: var(--ink);
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(25, 22, 36, 0.08);
}

/* 作品卡 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
  padding: 26rpx 32rpx 0;
}
.wcard {
  width: 332rpx;
  background: #fff;
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: var(--sh-1);
  transition: transform 0.18s ease;
}
.wcover {
  position: relative;
}
.wimg {
  display: block;
  width: 332rpx;
  height: 416rpx;
  background: #f1eef8;
}
.wtype {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(122, 92, 255, 0.92);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  letter-spacing: 1rpx;
}
.wmine {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(25, 22, 36, 0.55);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  backdrop-filter: blur(10rpx);
}
.wbody {
  padding: 20rpx 22rpx 22rpx;
}
.wauthor {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.wava {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  flex-shrink: 0;
}
.wava-fb {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--brand-ink);
  font-weight: 600;
}
.wname {
  font-size: 23rpx;
  color: var(--ink-2);
}
.wprompt {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink);
  line-height: 1.5;
  height: 72rpx;
}
.wfoot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}
.wuse {
  font-size: 21rpx;
  color: var(--ink-3);
}
.wlike {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--bg-2);
  transition: all 0.2s ease;
}
.wlike.on {
  background: var(--pink-soft);
}
.wlike-n {
  font-size: 22rpx;
  color: var(--ink-2);
  font-variant-numeric: tabular-nums;
}
.wlike.on .wlike-n {
  color: #d63a6a;
  font-weight: 600;
}

.more {
  text-align: center;
  padding: 36rpx 0 8rpx;
  font-size: 22rpx;
  color: var(--ink-4);
}
