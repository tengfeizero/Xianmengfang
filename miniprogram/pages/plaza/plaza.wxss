.plaza-page {
  padding-bottom: 20rpx;
}

.tabs {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  position: sticky;
  top: 0;
  z-index: 2;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.tab.active {
  color: #ff5c7a;
  font-weight: 600;
}
.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #ff5c7a;
}

.center-tip {
  text-align: center;
  padding: 60rpx 0;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 20rpx;
}
.card-work {
  width: 345rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.cover {
  display: block;
  width: 345rpx;
  height: 380rpx;
  background: #f5f0ee;
}
.body {
  padding: 12rpx 16rpx 16rpx;
}
.author {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ffe3ea;
}
.avatar-empty {
  text-align: center;
  line-height: 36rpx;
  font-size: 20rpx;
  color: #d63a58;
}
.nickname {
  font-size: 24rpx;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 220rpx;
}
.prompt {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #888;
  line-height: 1.4;
  height: 62rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}
.stat {
  font-size: 22rpx;
  color: #aaa;
}
.like {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #bbb;
  padding: 4rpx 10rpx;
}
.like.on {
  color: #ff5c7a;
}
