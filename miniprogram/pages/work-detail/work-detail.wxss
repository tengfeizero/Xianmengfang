/* 作品详情 */
.img-card {
  position: relative;
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: var(--r-xl);
  box-shadow: var(--sh-1);
  overflow: hidden;
}
.img {
  display: block;
  width: 100%;
  height: 640rpx;
  background: var(--bg-2);
}
.type-tag {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(122, 92, 255, 0.92);
  color: #fff;
  font-size: 21rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  letter-spacing: 1rpx;
}

.author {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.ava {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  flex-shrink: 0;
}
.ava-fb {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand-ink);
  font-size: 34rpx;
  font-weight: 600;
}
.st {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: 20rpx;
}
.st text {
  font-size: 25rpx;
  color: var(--ink-2);
  font-weight: 600;
}

.copy {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-ink);
  font-size: 24rpx;
  font-weight: 500;
  transition: transform 0.18s ease;
}
.p-text {
  margin-top: 18rpx;
  padding: 22rpx 26rpx;
  border-radius: var(--r-md);
  background: var(--bg);
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--ink-2);
}

.tip-card {
  padding: 24rpx 28rpx;
}
.tip-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.tip-row + .tip-row {
  margin-top: 16rpx;
}
.tip-row text {
  flex: 1;
  font-size: 23rpx;
  color: var(--ink-3);
  line-height: 1.5;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(25, 22, 36, 0.05);
  z-index: 100;
}
.f-act {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.18s ease;
}
.f-act.liked {
  background: var(--pink-soft);
  border-color: #ffd3e2;
}
.footer .btn.grow {
  flex: 1;
}
