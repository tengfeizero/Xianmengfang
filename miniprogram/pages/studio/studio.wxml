<view class="page page-tab studio">
  <!-- 画布 -->
  <view class="stage-wrap rise">
    <canvas
      type="2d"
      id="stage"
      class="stage"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
    ></canvas>

    <view class="stage-tools">
      <view class="tool" hover-class="press" bindtap="undo">
        <x-icon name="undo" size="32" color="#5c5b62" />
      </view>
      <view class="tool" hover-class="press" bindtap="clearAll">
        <x-icon name="eraser" size="32" color="#5c5b62" />
      </view>
    </view>

    <view class="stage-hint" wx:if="{{boardIdx < 0}}">
      <x-icon name="sparkles" size="26" color="#9a99a2" />
      <text>先选择一个底板，再点下面的素材装扮角色</text>
    </view>

    <!-- 选中元素浮层：缩放 + 删除 -->
    <view class="selbar" wx:if="{{selectedIdx >= 0}}">
      <view class="sel-name ell">{{placements[selectedIdx].name}}</view>
      <slider
        class="sel-slider"
        min="0.5"
        max="2"
        step="0.1"
        value="{{scaleVal}}"
        activeColor="#f2455f"
        backgroundColor="#ece8ea"
        blockSize="20"
        bindchange="onScale"
      />
      <view class="sel-del" hover-class="press" bindtap="removeSelected">
        <x-icon name="trash" size="30" color="#e0362f" />
      </view>
    </view>
  </view>

  <!-- 底板 -->
  <view class="sec">
    <text class="sec-title">选择底板</text>
    <text class="cap">已放 {{placements.length}}/12 个元素</text>
  </view>
  <scroll-view scroll-x class="board-scroll" show-scrollbar="{{false}}">
    <view class="board-row">
      <view
        wx:for="{{boards}}"
        wx:key="id"
        class="board {{boardIdx === index ? 'on' : ''}}"
        data-idx="{{index}}"
        bindtap="pickBoard"
        hover-class="press"
      >
        <view class="board-imgwrap">
          <image class="board-img" src="{{item.thumb}}" mode="aspectFill" />
        </view>
        <text class="board-name ell">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 素材抽屉 -->
  <view class="tray">
    <scroll-view scroll-x class="cat-scroll" show-scrollbar="{{false}}" wx:if="{{cats.length}}">
      <view class="cat-row">
        <view
          wx:for="{{cats}}"
          wx:key="key"
          class="chip chip-line {{catIdx === index ? 'on' : ''}}"
          data-idx="{{index}}"
          bindtap="pickCat"
        >{{item.label}}</view>
      </view>
    </scroll-view>
    <scroll-view scroll-x class="el-scroll" show-scrollbar="{{false}}">
      <view class="el-row">
        <view class="el" wx:for="{{elements}}" wx:key="id" data-id="{{item.id}}" bindtap="addElement" hover-class="press">
          <view class="el-imgwrap">
            <image class="el-img" src="{{item.full}}" mode="aspectFit" lazy-load />
          </view>
          <text class="el-name ell">{{item.name}}</text>
        </view>
        <view wx:if="{{!elements.length}}" class="el-empty">
          <text class="muted">{{cats.length ? '该分类暂无元素' : '该底板还没有配置元素'}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部操作 -->
  <view class="actions">
    <view class="act-ghost" hover-class="press" bindtap="goAI">
      <x-icon name="wand" size="34" color="#d92c47" />
      <text>AI 生成</text>
    </view>
    <view class="btn btn-primary act-main" hover-class="press" bindtap="compose">
      {{composing ? '生成中…' : '生成作品'}}
    </view>
  </view>
</view>
