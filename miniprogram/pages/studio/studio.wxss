.studio {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.stage {
  width: 670rpx;
  height: 840rpx;
  margin: 20rpx auto;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.sel-bar {
  display: flex;
  align-items: center;
  margin: 0 20rpx 16rpx;
  gap: 16rpx;
}
.sel-slider {
  flex: 1;
  margin: 0;
}
.board-row {
  display: flex;
  gap: 16rpx;
  padding: 0 20rpx 16rpx;
  overflow-x: auto;
}
.board-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 4rpx solid transparent;
  border-radius: 12rpx;
  padding: 8rpx;
  background: #fff;
}
.board-item.active {
  border-color: #ff7ea0;
}
.board-thumb {
  width: 100rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: #f5f0ee;
}
.board-name {
  font-size: 22rpx;
  margin-top: 6rpx;
  color: #666;
}
.cat-scroll {
  white-space: nowrap;
}
.cat-row {
  display: flex;
  gap: 14rpx;
  padding: 0 20rpx 14rpx;
}
.cat-tag {
  background: #fff;
  border-radius: 30rpx;
  padding: 10rpx 30rpx;
  font-size: 26rpx;
  color: #666;
}
.cat-tag.active {
  background: #ff7ea0;
  color: #fff;
}
.el-scroll {
  white-space: nowrap;
  background: #fff;
  margin: 0 20rpx;
  border-radius: 14rpx;
}
.el-row {
  display: flex;
  gap: 10rpx;
  padding: 16rpx;
  align-items: center;
}
.el-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 130rpx;
  flex-shrink: 0;
}
.el-img {
  width: 110rpx;
  height: 110rpx;
  background: #faf7f5;
  border-radius: 10rpx;
}
.el-name {
  font-size: 22rpx;
  color: #666;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 130rpx;
}
.el-empty {
  padding: 30rpx;
}
.actions {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 20rpx 0;
}
.act-btn {
  flex: 1;
}
