/* 创作工坊：画布 + 浮层工具 + 底板选择 + 素材抽屉 */
.studio {
  padding-bottom: calc(340rpx + env(safe-area-inset-bottom));
}
.stage-wrap {
  position: relative;
  margin: 20rpx 32rpx 0;
}
.stage {
  display: block;
  width: 686rpx;
  height: 820rpx;
  background: #fff;
  border-radius: var(--r-xl);
  box-shadow: var(--sh-1);
}
.stage-tools {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.tool {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: var(--sh-1);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.18s ease;
}
.stage-hint {
  position: absolute;
  left: 50%;
  top: 44%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 30rpx;
  background: rgba(26, 26, 29, 0.55);
  border-radius: 999rpx;
  backdrop-filter: blur(10rpx);
}
.stage-hint text {
  color: #fff;
  font-size: 24rpx;
}

/* 选中元素浮层 */
.selbar {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(16rpx);
  box-shadow: var(--sh-2);
  animation: riseIn 0.3s cubic-bezier(0.22, 0.68, 0, 1) both;
}
.sel-name {
  max-width: 160rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand-ink);
  flex-shrink: 0;
}
.sel-slider {
  flex: 1;
  margin: 0;
}
.sel-del {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #fef0f1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 底板选择 */
.board-scroll {
  white-space: nowrap;
}
.board-row {
  display: flex;
  gap: 18rpx;
  padding: 4rpx 32rpx 8rpx;
}
.board {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  transition: transform 0.18s ease;
}
.board-imgwrap {
  width: 120rpx;
  height: 150rpx;
  border-radius: 20rpx;
  padding: 6rpx;
  border: 4rpx solid transparent;
  background: #fff;
  box-shadow: var(--sh-1);
  transition: border-color 0.2s ease;
}
.board.on .board-imgwrap {
  border-color: var(--brand);
}
.board-img {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
  background: #f2f1f3;
  display: block;
}
.board-name {
  max-width: 132rpx;
  font-size: 22rpx;
  color: var(--ink-2);
}
.board.on .board-name {
  color: var(--brand-ink);
  font-weight: 600;
}

/* 素材抽屉 */
.tray {
  margin: 20rpx 32rpx 0;
  background: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--sh-1);
  padding: 20rpx 0 8rpx;
}
.cat-scroll {
  white-space: nowrap;
}
.cat-row {
  display: flex;
  gap: 14rpx;
  padding: 0 24rpx 16rpx;
}
.chip {
  height: 56rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}
.el-scroll {
  white-space: nowrap;
}
.el-row {
  display: flex;
  gap: 14rpx;
  padding: 4rpx 24rpx 16rpx;
  align-items: center;
}
.el {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 132rpx;
  flex-shrink: 0;
  transition: transform 0.18s ease;
}
.el-imgwrap {
  width: 116rpx;
  height: 116rpx;
  border-radius: 20rpx;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
}
.el-img {
  width: 100rpx;
  height: 100rpx;
}
.el-name {
  max-width: 132rpx;
  font-size: 21rpx;
  color: var(--ink-2);
}
.el-empty {
  padding: 30rpx 24rpx;
}

/* 底部操作条：悬浮在 tabBar 之上 */
.actions {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 18rpx;
  z-index: 50;
}
.act-ghost {
  flex: 1;
  height: 92rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--brand-ink);
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: var(--sh-1);
  transition: transform 0.18s ease;
}
.act-main {
  flex: 1.6;
  height: 92rpx;
}
