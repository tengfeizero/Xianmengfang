<view wx:if="{{order}}" class="page od">
  <!-- 状态头 + 进度 -->
  <view class="hero rise">
    <view class="blob b1"></view>
    <view class="blob b2"></view>
    <view class="hero-status">{{order.statusText}}</view>
    <view class="hero-desc">{{order.statusDesc}}</view>
    <view class="hero-tip" wx:if="{{order.cancelReason}}">取消原因：{{order.cancelReason}}</view>
    <view class="hero-tip" wx:if="{{order.refundFlag}}">商家已标记退款（演示阶段无资金流）</view>

    <!-- 进度条 -->
    <view class="track" wx:if="{{order.status !== 'canceled'}}">
      <block wx:for="{{steps}}" wx:key="key">
        <view class="track-item">
          <view class="dot {{index <= order.stepIdx ? 'on' : ''}}">
            <x-icon wx:if="{{index < order.stepIdx}}" name="check" size="20" color="#ffffff" />
          </view>
          <text class="track-label {{index <= order.stepIdx ? 'on' : ''}}">{{item.label}}</text>
        </view>
        <view wx:if="{{index !== steps.length - 1}}" class="seg {{index < order.stepIdx ? 'on' : ''}}"></view>
      </block>
    </view>
  </view>

  <!-- 商品明细 -->
  <view class="card">
    <view class="sec-t">商品信息</view>
    <view class="item" wx:for="{{items}}" wx:key="id">
      <image
        wx:if="{{item.imageUrl}}"
        class="item-img"
        src="{{item.imageUrl}}"
        mode="aspectFill"
        data-src="{{item.imageUrl}}"
        bindtap="preview"
      />
      <view wx:else class="item-img placeholder">暂无图</view>
      <view class="item-main">
        <view class="item-title">{{item.title}}</view>
        <view class="muted" wx:if="{{item.specsText}}">{{item.specsText}}</view>
        <view class="work-line" wx:if="{{item.workImageUrl}}" data-src="{{item.workImageUrl}}" bindtap="preview">
          <image class="work-img" src="{{item.workImageUrl}}" mode="aspectFill" />
          <view class="col">
            <text class="work-t">定制作品</text>
            <text class="cap">点击放大</text>
          </view>
        </view>
        <view class="item-foot">
          <text class="price"><text class="yuan">¥</text><text class="num">{{item.priceText}}</text></text>
          <text class="muted">x{{item.qty}}</text>
          <text class="subtotal num">小计 ¥{{item.subtotalText}}</text>
        </view>
      </view>
    </view>

    <view class="amounts">
      <view class="kv"><text class="k">商品金额</text><text class="v num">¥{{amounts.itemsText}}</text></view>
      <view class="kv">
        <text class="k">运费</text>
        <text class="v">{{amounts.shippingText === '0.00' ? '免运费' : '¥' + amounts.shippingText}}</text>
      </view>
      <view class="kv" wx:if="{{amounts.hasDiscount}}">
        <text class="k">优惠</text>
        <text class="v price">-¥{{amounts.discountText}}</text>
      </view>
      <view class="kv total">
        <text class="k">实付金额</text>
        <view class="price t-price"><text class="yuan">¥</text><text class="num">{{amounts.totalText}}</text></view>
      </view>
    </view>
  </view>

  <!-- 收货信息 -->
  <view class="card" wx:if="{{order.receiverName}}">
    <view class="sec-t">收货信息</view>
    <view class="recv-top">
      <text class="recv-name">{{order.receiverName}}</text>
      <text class="muted">{{order.receiverPhone}}</text>
      <text class="copy" data-text="{{order.receiverPhone}}" bindtap="copy">复制电话</text>
    </view>
    <view class="recv-addr">{{order.receiverAddress}}</view>
    <view class="recv-ops">
      <text class="copy" data-text="{{order.receiverAddress}}" bindtap="copy">复制地址</text>
    </view>
  </view>

  <!-- 物流信息 -->
  <view class="card" wx:if="{{shipment}}">
    <view class="sec-t">物流信息</view>
    <view class="ship-row">
      <view class="ship-ic"><x-icon name="truck" size="34" color="#3b82f6" /></view>
      <view class="col grow">
        <view class="row between">
          <text class="strong">{{shipment.company}}</text>
          <text class="copy" data-text="{{shipment.trackingNo}}" bindtap="copy">复制运单号</text>
        </view>
        <text class="mono mt8">{{shipment.trackingNo}}</text>
        <text class="cap mt8" wx:if="{{shipment.time}}">发货时间 {{shipment.time}}</text>
      </view>
    </view>
    <view class="ship-tip">物流轨迹待接入快递查询，可凭运单号到快递官网查询</view>
  </view>

  <!-- 订单信息 -->
  <view class="card">
    <view class="sec-t">订单信息</view>
    <view class="kv">
      <text class="k">订单编号</text>
      <view class="v">
        <text class="mono">{{order.orderNo}}</text>
        <text class="copy" data-text="{{order.orderNo}}" bindtap="copy">复制</text>
      </view>
    </view>
    <view class="kv"><text class="k">下单时间</text><text class="v">{{order.createdAt}}</text></view>
    <view class="kv"><text class="k">支付方式</text><text class="v">{{order.payType}}</text></view>
    <view class="kv" wx:if="{{order.payTime}}"><text class="k">支付时间</text><text class="v">{{order.payTime}}</text></view>
  </view>

  <!-- 订单进度流水 -->
  <view class="card" wx:if="{{events.length}}">
    <view class="sec-t">订单进度</view>
    <view class="timeline">
      <view class="tl-item {{index === 0 ? 'latest' : ''}}" wx:for="{{events}}" wx:key="id">
        <view class="tl-rail">
          <view class="tl-dot"></view>
          <view class="tl-line" wx:if="{{index !== events.length - 1}}"></view>
        </view>
        <view class="tl-body">
          <view class="tl-top">
            <text class="tl-action">{{item.action}}</text>
            <text class="cap">{{item.time}}</text>
          </view>
          <view class="cap tl-note" wx:if="{{item.note}}">{{item.note}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="footer" wx:if="{{canCancel || canConfirm}}">
    <view wx:if="{{canCancel}}" class="btn btn-ghost grow" hover-class="press" bindtap="cancel">取消订单</view>
    <view wx:if="{{canConfirm}}" class="btn btn-primary grow" hover-class="press" bindtap="confirm">确认收货</view>
  </view>
</view>

<view wx:else class="page">
  <x-skeleton wx:if="{{loading}}" type="card" count="1" />
  <x-empty wx:elif="{{!loading}}" icon="ticket" text="订单不存在或已失效" />
</view>
