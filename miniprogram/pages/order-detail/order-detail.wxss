/* 订单详情 */
.od {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}
.hero {
  position: relative;
  margin: 24rpx 32rpx 0;
  padding: 40rpx 36rpx 34rpx;
  background: linear-gradient(135deg, #7a5cff 0%, #a673ff 55%, #ff6fa5 100%);
  border-radius: var(--r-xl);
  box-shadow: var(--sh-brand);
  overflow: hidden;
}
.hero-status {
  position: relative;
  z-index: 2;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.5rpx;
}
.hero-desc {
  position: relative;
  z-index: 2;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}
.hero-tip {
  position: relative;
  z-index: 2;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* 进度条 */
.track {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  margin-top: 34rpx;
  padding-top: 26rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.25);
}
.track-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 84rpx;
  flex-shrink: 0;
}
.dot {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
  border: 3rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}
.dot.on {
  background: #fff;
  border-color: #fff;
}
.track-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.72);
  white-space: nowrap;
}
.track-label.on {
  color: #fff;
  font-weight: 600;
}
.seg {
  flex: 1;
  height: 4rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.3);
  margin-top: 14rpx;
  transition: background 0.25s ease;
}
.seg.on {
  background: #fff;
}

/* 卡片通用 */
.card {
  margin: 22rpx 32rpx 0;
}
.sec-t {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 22rpx;
}

/* 商品明细 */
.item {
  display: flex;
  gap: 22rpx;
  padding: 20rpx 0;
}
.item + .item {
  border-top: 2rpx solid var(--line);
}
.item-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--r-md);
  background: #f1eef8;
  flex-shrink: 0;
}
.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--ink-4);
}
.item-main {
  flex: 1;
  min-width: 0;
}
.item-title {
  font-size: 28rpx;
  font-weight: 600;
}
.work-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
  padding: 10rpx;
  border-radius: var(--r-sm);
  background: var(--bg);
}
.work-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 10rpx;
}
.work-t {
  font-size: 23rpx;
  font-weight: 500;
}
.item-foot {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 12rpx;
}
.item-foot .price {
  font-size: 28rpx;
}
.subtotal {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--ink-2);
  font-weight: 600;
}

/* 金额 */
.amounts {
  margin-top: 14rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}
.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 25rpx;
}
.k {
  color: var(--ink-3);
}
.v {
  color: var(--ink);
}
.kv.total {
  padding-top: 16rpx;
}
.t-price {
  font-size: 36rpx;
}

/* 收货 */
.recv-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.recv-name {
  font-size: 30rpx;
  font-weight: 600;
}
.copy {
  color: var(--brand-ink);
  font-size: 23rpx;
  font-weight: 500;
}
.recv-addr {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--ink-2);
  line-height: 1.6;
}
.recv-ops {
  margin-top: 12rpx;
}

/* 物流 */
.ship-row {
  display: flex;
  gap: 20rpx;
}
.ship-ic {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #eaf1ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.mono {
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
  color: var(--ink-2);
}
.ship-tip {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: var(--r-sm);
  background: var(--bg);
  font-size: 21rpx;
  color: var(--ink-4);
}

/* 时间线 */
.tl-item {
  display: flex;
  gap: 18rpx;
}
.tl-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tl-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ded9ea;
  margin-top: 8rpx;
  flex-shrink: 0;
}
.tl-item.latest .tl-dot {
  background: var(--brand);
  box-shadow: 0 0 0 8rpx var(--brand-soft);
}
.tl-line {
  width: 3rpx;
  flex: 1;
  background: var(--line);
  margin: 6rpx 0;
}
.tl-body {
  flex: 1;
  padding-bottom: 28rpx;
}
.tl-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tl-action {
  font-size: 26rpx;
  font-weight: 600;
}
.tl-item.latest .tl-action {
  color: var(--brand-ink);
}
.tl-note {
  margin-top: 4rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(25, 22, 36, 0.05);
  z-index: 100;
}
.footer .btn.grow {
  flex: 1;
  height: 88rpx;
}
