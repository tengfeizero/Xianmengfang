.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f7f2f0;
}
.form-row:last-child {
  border-bottom: none;
}
.form-row.col {
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}
.label {
  width: 160rpx;
  flex-shrink: 0;
  color: #666;
}
.form-row.col .label {
  width: auto;
}
.input {
  flex: 1;
  font-size: 28rpx;
}
.input.placeholder {
  color: #bbb;
}
.region {
  padding: 4rpx 0;
}
.detail {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  background: #faf7f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.save-btn {
  margin: 40rpx 20rpx;
}
