/* 地址编辑 */
.form-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}
.form-row + .form-row {
  border-top: 2rpx solid var(--line);
}
.form-row.col {
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}
.label {
  width: 170rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: var(--ink-2);
}
.form-row.col .label {
  width: auto;
}
.input {
  flex: 1;
  font-size: 28rpx;
}
.ph {
  color: var(--ink-4);
}
.region {
  flex: 1;
}
.detail {
  width: 100%;
  height: 84rpx;
  background: var(--bg);
  border-radius: var(--r-md);
  padding: 0 24rpx;
  box-sizing: border-box;
}
.save {
  margin: 32rpx 32rpx 0;
}
