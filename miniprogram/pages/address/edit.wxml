<view class="card">
  <view class="form-row">
    <text class="label">收货人</text>
    <input class="input" value="{{name}}" data-field="name" bindinput="onInput" placeholder="姓名" />
  </view>
  <view class="form-row">
    <text class="label">手机号</text>
    <input class="input" type="number" maxlength="11" value="{{phone}}" data-field="phone" bindinput="onInput" placeholder="11 位手机号" />
  </view>
  <view class="form-row">
    <text class="label">所在地区</text>
    <picker mode="region" value="{{region}}" bindchange="onRegion">
      <view class="input region {{region[0] ? '' : 'placeholder'}}">
        {{region[0] ? region[0] + ' ' + region[1] + ' ' + region[2] : '选择省 / 市 / 区'}}
      </view>
    </picker>
  </view>
  <view class="form-row col">
    <text class="label">详细地址</text>
    <textarea class="input detail" value="{{detail}}" data-field="detail" bindinput="onInput" maxlength="120" placeholder="街道、门牌号、楼栋单元等" />
  </view>
  <view class="form-row">
    <text class="label">设为默认</text>
    <switch checked="{{isDefault}}" color="#ff7ea0" bindchange="onDefault" />
  </view>
</view>

<button class="btn-pink save-btn" disabled="{{saving}}" bindtap="save">
  {{saving ? '保存中...' : '保存'}}
</button>
