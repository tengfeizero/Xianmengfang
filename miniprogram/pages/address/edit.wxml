<view class="page page-bar">
  <view class="card rise">
    <view class="form-row">
      <text class="label">收货人</text>
      <input class="input" value="{{name}}" data-field="name" bindinput="onInput" cursor-spacing="24" placeholder="姓名" placeholder-class="ph" />
    </view>
    <view class="form-row">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" value="{{phone}}" data-field="phone" bindinput="onInput" cursor-spacing="24" placeholder="11 位手机号" placeholder-class="ph" />
    </view>
    <view class="form-row">
      <text class="label">所在地区</text>
      <picker mode="region" value="{{region}}" bindchange="onRegion">
        <view class="input region {{region[0] ? '' : 'ph'}}">
          {{region[0] ? region[0] + ' ' + region[1] + ' ' + region[2] : '选择省 / 市 / 区'}}
        </view>
      </picker>
      <x-icon name="right" size="24" color="#c4bdd1" />
    </view>
    <view class="form-row col">
      <text class="label">详细地址</text>
      <input class="input detail" value="{{detail}}" data-field="detail" bindinput="onInput" maxlength="120" cursor-spacing="24" placeholder="街道、门牌号、楼栋单元等" placeholder-class="ph" />
    </view>
    <view class="form-row">
      <text class="label">设为默认</text>
      <view class="grow"></view>
      <switch checked="{{isDefault}}" color="#6c5ce7" bindchange="onDefault" />
    </view>
  </view>

  <view class="btn btn-primary btn-lg btn-block save rise d1" hover-class="press" bindtap="save">
    {{saving ? '保存中…' : '保存地址'}}
  </view>
</view>
