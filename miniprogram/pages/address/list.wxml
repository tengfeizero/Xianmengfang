<view wx:if="{{loading}}" class="muted center-tip">加载中...</view>
<view wx:elif="{{!addresses.length}}" class="muted center-tip">还没有收货地址</view>

<view class="card addr" wx:for="{{addresses}}" wx:key="id" data-id="{{item.id}}" bindtap="pick">
  <view class="addr-head">
    <text class="addr-name">{{item.name}}</text>
    <text class="muted">{{item.phone}}</text>
    <text wx:if="{{item.isDefault}}" class="default-tag">默认</text>
  </view>
  <view class="addr-detail">{{item.full}}</view>
  <view class="addr-actions">
    <button size="mini" data-id="{{item.id}}" catchtap="setDefault" wx:if="{{!item.isDefault}}">设为默认</button>
    <button size="mini" data-id="{{item.id}}" catchtap="edit">编辑</button>
    <button size="mini" type="warn" plain data-id="{{item.id}}" catchtap="del">删除</button>
  </view>
</view>

<view class="tip muted" wx:if="{{selectMode && addresses.length}}">点击地址卡片即可选用</view>

<view class="footer-space"></view>
<view class="footer">
  <button class="btn-pink footer-btn" bindtap="add">+ 新增收货地址</button>
</view>
