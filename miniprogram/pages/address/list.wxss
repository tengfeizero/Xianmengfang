/* 地址列表 */
.tip-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 24rpx 32rpx 0;
  padding: 18rpx 26rpx;
  border-radius: var(--r-md);
  background: var(--brand-soft);
}
.tip-bar text {
  font-size: 23rpx;
  color: var(--brand-ink);
}
.a-card {
  margin: 22rpx 32rpx 0;
  padding: 28rpx;
  background: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--sh-1);
  transition: transform 0.18s ease;
}
.a-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.a-ic {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: #e8f8f4;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.a-name {
  font-size: 30rpx;
  font-weight: 700;
}
.a-op {
  padding: 8rpx;
}
.a-detail {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.6;
}
.a-foot {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}
.set-def {
  font-size: 24rpx;
  color: var(--brand-ink);
  font-weight: 500;
  padding: 6rpx 10rpx;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(247, 246, 247, 0.96);
  backdrop-filter: blur(20rpx);
  z-index: 100;
}
