.addr-card {
  position: relative;
}
.addr-empty {
  background: #fffaf0;
}
.addr-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.addr-name {
  font-weight: 600;
}
.addr-tag {
  background: #ff7ea0;
  color: #fff;
  font-size: 20rpx;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}
.addr-pick-tip {
  font-weight: 500;
}
.addr-manage {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  color: #ff7ea0;
  font-size: 24rpx;
}
.p-cover {
  width: 100%;
  height: 420rpx;
  border-radius: 12rpx;
  background: #f5f0ee;
}
.p-title {
  font-size: 34rpx;
  font-weight: 600;
  margin: 20rpx 0 8rpx;
}
.sec-title {
  font-weight: 600;
  margin-bottom: 20rpx;
}
.sku-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.sku-tag {
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
}
.sku-tag.active {
  border-color: #ff7ea0;
  color: #ff7ea0;
  background: #fff0f4;
}
.sku-tag.disabled {
  color: #ccc;
}
.qty-row {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  gap: 24rpx;
}
.qty-input {
  width: 120rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  padding: 8rpx 16rpx;
  text-align: center;
}
.works-scroll {
  white-space: nowrap;
}
.works-row {
  display: flex;
  gap: 16rpx;
}
.work-thumb {
  width: 120rpx;
  height: 150rpx;
  border-radius: 10rpx;
  border: 4rpx solid transparent;
  background: #f5f0ee;
}
.work-thumb.active {
  border-color: #ff7ea0;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.footer-total {
  flex: 1;
}
.footer-btn {
  width: 340rpx;
}
.gallery-card {
  padding: 0;
  overflow: hidden;
}
.gallery {
  width: 100%;
  height: 640rpx;
}
.gallery-img {
  width: 100%;
  height: 640rpx;
  background: #f5f0ee;
}
.p-title {
  margin-top: 0;
}
.p-subtitle {
  font-size: 26rpx;
  color: #8a8580;
  margin-bottom: 12rpx;
}
.price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.p-price {
  font-size: 40rpx;
  font-weight: 600;
  color: #ff5c8a;
}
.p-price-suffix {
  font-size: 24rpx;
  font-weight: 400;
}
.p-origin {
  font-size: 24rpx;
  color: #b8b0aa;
  text-decoration: line-through;
}
.service-notes {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: #fff7f9;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #8a6d70;
  line-height: 1.5;
}
.service-label {
  flex-shrink: 0;
  background: #ff7ea0;
  color: #fff;
  font-size: 20rpx;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-top: 2rpx;
}
.detail-par {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
  margin-bottom: 16rpx;
  white-space: pre-wrap;
}
.detail-img {
  width: 100%;
  border-radius: 10rpx;
  margin-bottom: 16rpx;
  display: block;
  background: #f5f0ee;
}
.refund-tip {
  text-align: center;
  font-size: 22rpx;
  color: #b0a8a2;
  padding: 8rpx 0 140rpx;
}
.footer-total {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
