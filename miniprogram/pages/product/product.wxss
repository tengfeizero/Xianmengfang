/* 商品详情 */
.gallery {
  position: relative;
}
.g-swiper,
.g-single {
  width: 750rpx;
  height: 750rpx;
  display: block;
}
.g-img {
  width: 750rpx;
  height: 750rpx;
  background: #f1eef8;
}
.g-ind {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(25, 22, 36, 0.5);
  backdrop-filter: blur(10rpx);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
}

.info {
  position: relative;
  margin: -40rpx 32rpx 0;
  padding: 32rpx;
  background: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--sh-1);
}
.i-price {
  font-size: 48rpx;
}
.i-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: -0.5rpx;
}
.services {
  display: flex;
  align-items: center;
  gap: 26rpx;
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid var(--line);
}
.sv {
  display: flex;
  align-items: center;
  gap: 6rpx;
  max-width: 220rpx;
}
.sv text {
  font-size: 22rpx;
  color: var(--ink-2);
}

.addr {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 22rpx;
}
.addr-ic {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #e8f8f4;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.a-name {
  font-size: 28rpx;
  font-weight: 600;
}
.a-full {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}
.a-manage {
  font-size: 24rpx;
  color: var(--brand-ink);
  font-weight: 500;
}

.skus {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}
.sku {
  min-width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
  padding: 18rpx 24rpx;
  border-radius: var(--r-md);
  border: 3rpx solid var(--line);
  background: var(--bg-2);
  transition: all 0.2s ease;
  max-width: 100%;
}
.sku.on {
  border-color: var(--brand);
  background: var(--brand-soft);
}
.sku.dis {
  opacity: 0.45;
}
.sku-specs {
  font-size: 25rpx;
  font-weight: 500;
  max-width: 320rpx;
}
.sku-price {
  font-size: 23rpx;
  color: var(--ink-3);
}
.sku.on .sku-price {
  color: var(--brand-ink);
}

.qty {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--bg);
  border-radius: 999rpx;
  padding: 6rpx;
}
.q-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--ink-2);
  box-shadow: 0 2rpx 8rpx rgba(25, 22, 36, 0.08);
  transition: transform 0.18s ease;
}
.q-input {
  width: 70rpx;
  text-align: center;
  font-size: 29rpx;
  font-weight: 600;
}

.w-sec {
  margin-top: 24rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  margin-bottom: 14rpx;
}
.w-scroll {
  white-space: nowrap;
}
.w-row {
  display: flex;
  gap: 16rpx;
}
.w-thumb {
  position: relative;
  width: 128rpx;
  height: 160rpx;
  border-radius: 18rpx;
  overflow: hidden;
  flex-shrink: 0;
  border: 4rpx solid transparent;
  transition: border-color 0.2s ease;
}
.w-thumb.on {
  border-color: var(--brand);
}
.w-img {
  width: 100%;
  height: 100%;
  background: #f1eef8;
}
.w-check {
  position: absolute;
  inset: 0;
  background: rgba(108, 92, 231, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
}
.w-tip {
  margin-top: 16rpx;
  font-size: 21rpx;
  color: var(--ink-4);
}
.clear {
  font-size: 24rpx;
  color: var(--brand-ink);
  font-weight: 500;
}

.detail {
  margin-top: 18rpx;
}
.d-par {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.8;
  margin-bottom: 18rpx;
  white-space: pre-wrap;
}
.d-img {
  width: 100%;
  border-radius: var(--r-md);
  margin-bottom: 18rpx;
  display: block;
  background: #f1eef8;
}
.refund {
  text-align: center;
  padding: 28rpx 0 10rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(25, 22, 36, 0.05);
  z-index: 100;
}
.f-cart {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.18s ease;
}
.f-badge {
  position: absolute;
  top: -4rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--pink);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
  border: 3rpx solid #fff;
}
.footer .btn.grow {
  flex: 1;
  height: 88rpx;
}
