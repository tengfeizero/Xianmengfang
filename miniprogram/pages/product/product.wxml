<view class="page page-bar" wx:if="{{product}}">
  <!-- 画廊 -->
  <view class="gallery rise">
    <swiper wx:if="{{product.images.length > 1}}" class="g-swiper" circular bindchange="onSwiper">
      <swiper-item wx:for="{{product.images}}" wx:key="*this">
        <image class="g-img" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewImage" />
      </swiper-item>
    </swiper>
    <image
      wx:else
      class="g-img g-single"
      src="{{product.images[0]}}"
      mode="aspectFill"
      data-url="{{product.images[0]}}"
      bindtap="previewImage"
    />
    <view wx:if="{{product.images.length > 1}}" class="g-ind num">{{galleryIdx + 1}}/{{product.images.length}}</view>
  </view>

  <!-- 信息 -->
  <view class="info rise">
    <view class="row g16">
      <view class="price i-price"><text class="yuan">¥</text><text class="num">{{product.priceText}}</text></view>
      <view class="price-origin" wx:if="{{product.originalText}}">¥{{product.originalText}}</view>
      <view class="grow"></view>
      <text class="cap">定制生产</text>
    </view>
    <view class="i-title">{{product.title}}</view>
    <view class="sub mt8" wx:if="{{product.subtitle}}">{{product.subtitle}}</view>
    <view class="services" wx:if="{{product.serviceNotes}}">
      <view class="sv"><x-icon name="check" size="24" color="#14b8a6" /><text>工厂直做</text></view>
      <view class="sv"><x-icon name="check" size="24" color="#14b8a6" /><text>全店包邮</text></view>
      <view class="sv"><x-icon name="check" size="24" color="#14b8a6" /><text class="ell">{{product.serviceNotes}}</text></view>
    </view>
  </view>

  <!-- 收货地址 -->
  <view class="card addr rise d1" hover-class="press-soft" bindtap="chooseAddress">
    <view class="addr-ic"><x-icon name="pin" size="32" color="#14b8a6" /></view>
    <view class="col grow" wx:if="{{selectedAddress}}">
      <view class="row g12">
        <text class="a-name">{{selectedAddress.name}}</text>
        <text class="cap">{{selectedAddress.phone}}</text>
        <view wx:if="{{selectedAddress.isDefault}}" class="tag tag-soft">默认</view>
      </view>
      <text class="a-full ell">{{selectedAddress.full}}</text>
    </view>
    <view class="col grow" wx:else>
      <text class="a-name">请选择收货地址</text>
      <text class="cap mt8">定制商品需要先填写收货信息</text>
    </view>
    <text class="a-manage" catchtap="manageAddress">管理</text>
  </view>

  <!-- 规格 -->
  <view class="card rise d2">
    <view class="row between">
      <text class="h3">选择规格</text>
      <text class="cap">{{selectedSku ? '已选 ' + selectedSku.specsText : '请选择规格'}}</text>
    </view>
    <view class="skus">
      <view
        wx:for="{{skus}}"
        wx:key="id"
        class="sku {{selectedSku && selectedSku.id === item.id ? 'on' : ''}} {{item.stock <= 0 ? 'dis' : ''}}"
        data-id="{{item.id}}"
        bindtap="pickSku"
        hover-class="press-soft"
      >
        <text class="sku-specs ell">{{item.specsText}}</text>
        <text class="sku-price num">¥{{item.priceText}}</text>
      </view>
    </view>
    <view class="hr"></view>
    <view class="row between">
      <text class="h3">数量</text>
      <view class="qty">
        <view class="q-btn" hover-class="press" data-delta="-1" bindtap="changeQty"><text>−</text></view>
        <input class="q-input num" type="number" value="{{qty}}" bindblur="onQty" />
        <view class="q-btn" hover-class="press" data-delta="1" bindtap="changeQty"><text>＋</text></view>
      </view>
    </view>
  </view>

  <!-- 定制图案 -->
  <view class="card rise d3" wx:if="{{myWorks.length || likedWorks.length}}">
    <view class="row between">
      <text class="h3">定制图案</text>
      <text wx:if="{{selectedWork}}" class="clear" bindtap="clearWork">清除已选</text>
    </view>

    <block wx:if="{{myWorks.length}}">
      <view class="w-sec">我的作品</view>
      <scroll-view scroll-x class="w-scroll" show-scrollbar="{{false}}">
        <view class="w-row">
          <view
            wx:for="{{myWorks}}"
            wx:key="id"
            class="w-thumb {{selectedWork && selectedWork.id === item.id ? 'on' : ''}}"
            data-id="{{item.id}}"
            bindtap="pickWork"
            hover-class="press-soft"
          >
            <image class="w-img" src="{{item.cover}}" mode="aspectFill" />
            <view wx:if="{{selectedWork && selectedWork.id === item.id}}" class="w-check">
              <x-icon name="check" size="22" color="#ffffff" />
            </view>
          </view>
        </view>
      </scroll-view>
    </block>

    <block wx:if="{{likedWorks.length}}">
      <view class="w-sec">我赞过的作品</view>
      <scroll-view scroll-x class="w-scroll" show-scrollbar="{{false}}">
        <view class="w-row">
          <view
            wx:for="{{likedWorks}}"
            wx:key="id"
            class="w-thumb {{selectedWork && selectedWork.id === item.id ? 'on' : ''}}"
            data-id="{{item.id}}"
            bindtap="pickWork"
            hover-class="press-soft"
          >
            <image class="w-img" src="{{item.cover}}" mode="aspectFill" />
            <view wx:if="{{selectedWork && selectedWork.id === item.id}}" class="w-check">
              <x-icon name="check" size="22" color="#ffffff" />
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="w-tip">在灵感广场点赞后，就能借用作品下单</view>
    </block>
  </view>

  <!-- 图文详情 -->
  <view class="card rise d4" wx:if="{{product.detailParagraphs.length || product.detailImages.length}}">
    <view class="h3">图文详情</view>
    <view class="detail">
      <view class="d-par" wx:for="{{product.detailParagraphs}}" wx:key="*this">{{item}}</view>
      <image
        wx:for="{{product.detailImages}}"
        wx:key="*this"
        class="d-img"
        src="{{item}}"
        mode="widthFix"
        data-url="{{item}}"
        bindtap="previewImage"
      />
    </view>
  </view>

  <view class="refund cap">定制商品不支持七天无理由退货 · 下单后工厂即开始生产</view>

  <!-- 底部操作 -->
  <view class="footer">
    <view class="f-cart" hover-class="press" bindtap="goCart">
      <x-icon name="cart" size="40" color="#1a1a1d" />
      <view wx:if="{{cartCount}}" class="f-badge num">{{cartCount > 99 ? '99+' : cartCount}}</view>
    </view>
    <view class="btn btn-ghost grow" hover-class="press" bindtap="addCart">加入购物车</view>
    <view class="btn btn-primary grow" hover-class="press" bindtap="submit">立即购买</view>
  </view>
</view>

<view wx:else class="page">
  <x-skeleton wx:if="{{loading}}" type="card" count="1" />
  <x-empty wx:elif="{{!loading}}" icon="package" text="商品不存在或已下架" />
</view>
