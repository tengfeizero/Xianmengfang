<view wx:if="{{product}}">
  <view class="card addr-card {{selectedAddress ? '' : 'addr-empty'}}" bindtap="chooseAddress">
    <block wx:if="{{selectedAddress}}">
      <view class="addr-line">
        <text class="addr-name">{{selectedAddress.name}}</text>
        <text class="muted">{{selectedAddress.phone}}</text>
        <text wx:if="{{selectedAddress.isDefault}}" class="addr-tag">默认</text>
      </view>
      <view class="muted">{{selectedAddress.full}}</view>
    </block>
    <block wx:else>
      <view class="addr-pick-tip">📍 请选择收货地址</view>
    </block>
    <view class="addr-manage" catchtap="manageAddress">管理地址 ›</view>
  </view>

  <view class="card gallery-card">
    <swiper wx:if="{{product.images.length > 1}}" class="gallery" indicator-dots indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff" circular>
      <swiper-item wx:for="{{product.images}}" wx:key="*this">
        <image class="gallery-img" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewImage" />
      </swiper-item>
    </swiper>
    <image
      wx:else
      class="p-cover"
      src="{{product.images[0]}}"
      mode="aspectFill"
      data-url="{{product.images[0]}}"
      bindtap="previewImage"
    />
  </view>

  <view class="card">
    <view class="p-title">{{product.title}}</view>
    <view wx:if="{{product.subtitle}}" class="p-subtitle">{{product.subtitle}}</view>
    <view class="price-row">
      <view class="p-price">¥{{product.priceText}}<text wx:if="{{skus.length > 1}}" class="p-price-suffix"> 起</text></view>
      <view wx:if="{{product.originalText}}" class="p-origin">¥{{product.originalText}}</view>
    </view>
    <view wx:if="{{product.serviceNotes}}" class="service-notes">
      <text class="service-label">服务</text>
      <text>{{product.serviceNotes}}</text>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">选择规格</view>
    <view class="sku-row">
      <view
        wx:for="{{skus}}"
        wx:key="id"
        class="sku-tag {{selectedSku && selectedSku.id === item.id ? 'active' : ''}} {{item.stock <= 0 ? 'disabled' : ''}}"
        data-id="{{item.id}}"
        bindtap="pickSku"
      >
        {{item.specsText}} ¥{{item.priceText}}
      </view>
    </view>
    <view class="qty-row">
      <text>数量</text>
      <input class="qty-input" type="number" value="{{qty}}" bindblur="onQty" />
      <text class="muted">共 {{qty}} {{product.unit}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{works.length}}">
    <view class="sec-title">使用我的作品（可不选）</view>
    <scroll-view scroll-x class="works-scroll">
      <view class="works-row">
        <image
          wx:for="{{works}}"
          wx:key="id"
          class="work-thumb {{selectedWork && selectedWork.id === item.id ? 'active' : ''}}"
          src="{{item.cover}}"
          data-id="{{item.id}}"
          mode="aspectFill"
          bindtap="pickWork"
        />
      </view>
    </scroll-view>
  </view>

  <view class="card" wx:if="{{product.detailParagraphs.length || product.detailImages.length}}">
    <view class="sec-title">图文详情</view>
    <view class="detail-par" wx:for="{{product.detailParagraphs}}" wx:key="*this">{{item}}</view>
    <image
      wx:for="{{product.detailImages}}"
      wx:key="*this"
      class="detail-img"
      src="{{item}}"
      mode="widthFix"
      data-url="{{item}}"
      bindtap="previewImage"
    />
  </view>

  <view class="refund-tip">提交订单即表示同意：定制商品不支持七天无理由退货</view>

  <view class="footer">
    <view class="footer-total">
      合计 <text class="price">¥{{totalText}}</text>
    </view>
    <button class="btn-pink footer-btn" disabled="{{submitting}}" bindtap="submit">
      {{submitting ? '提交中...' : '模拟支付并下单'}}
    </button>
  </view>
</view>
