.panel {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--sh-1);
  padding: 8rpx 28rpx;
}
.cell {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 0;
  transition: transform 0.18s ease;
}
.cell + .cell {
  border-top: 2rpx solid var(--line);
}
.cell-ic {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cell-t {
  font-size: 28rpx;
}
.cell-t.red {
  color: var(--red);
}

.ver {
  display: block;
  text-align: center;
  padding: 40rpx 0 12rpx;
}
