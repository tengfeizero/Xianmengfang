<view class="page">
  <view class="panel rise">
    <view class="cell">
      <view class="cell-ic" style="background:#f1eeff"><x-icon name="bell" size="34" color="#6c5ce7" /></view>
      <view class="col grow">
        <text class="cell-t">消息通知</text>
        <text class="cap mt8">订单进度与积分变动提醒</text>
      </view>
      <switch checked="{{notify}}" color="#6c5ce7" bindchange="onNotify" />
    </view>
    <view class="cell" hover-class="press-soft" bindtap="clearCache">
      <view class="cell-ic" style="background:#e8f8f4"><x-icon name="eraser" size="34" color="#14b8a6" /></view>
      <view class="col grow">
        <text class="cell-t">清除缓存</text>
        <text class="cap mt8">当前 {{cacheText}}</text>
      </view>
      <x-icon name="right" size="24" color="#c4bdd1" />
    </view>
  </view>

  <!-- 账号：注销（不可逆，红）/ 退出登录（可再登回） -->
  <view class="panel rise d1 danger">
    <view class="d-row" hover-class="press-soft" bindtap="deactivate">
      <text class="d-t red">注销账号</text>
    </view>
    <view class="d-row" hover-class="press-soft" bindtap="logout">
      <text class="d-t">退出登录</text>
    </view>
  </view>
  <view class="cap tip rise d2">注销将清空作品、点赞、购物车与收货地址，且无法恢复</view>

  <view class="cap ver">现梦坊 {{version}}</view>
</view>
