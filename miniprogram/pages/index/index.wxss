/* 首页：品牌栏 + 搜索 + 主视觉 + 四宫格 + 灵感 + 商品 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 8rpx;
}
.brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.logo-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ff6b7d 0%, #f2455f 52%, #d92c47 100%);
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 22rpx rgba(242, 69, 95, 0.28);
}
.brand-name {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.2;
}
.brand-sub {
  font-size: 20rpx;
  color: var(--ink-3);
  margin-top: 2rpx;
  letter-spacing: 0.5rpx;
}
.icon-btn {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-1);
  transition: transform 0.18s ease;
}
.badge {
  position: absolute;
  top: -4rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--pink);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
  border: 3rpx solid var(--bg);
}

/* 搜索（吸顶） */
.search-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
  padding: 20rpx 0 12rpx;
  background: var(--bg);
}
.search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 0 32rpx;
  height: 84rpx;
  padding: 0 12rpx 0 28rpx;
  background: #fff;
  border-radius: 999rpx;
  box-shadow: var(--sh-1);
  transition: transform 0.18s ease;
}
.search-ph {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink-3);
}
.search-go {
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--ink);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}

/* Hero */
.hero {
  position: relative;
  margin: 24rpx 32rpx 0;
  height: 356rpx;
  border-radius: var(--r-xl);
  background: linear-gradient(135deg, #ff6b7d 0%, #f2455f 52%, #d92c47 100%);
  box-shadow: 0 22rpx 44rpx rgba(242, 69, 95, 0.28);
  overflow: hidden;
}
.blob {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}
.b1 {
  width: 300rpx;
  height: 300rpx;
  right: -80rpx;
  top: -110rpx;
}
.b2 {
  width: 180rpx;
  height: 180rpx;
  right: 90rpx;
  bottom: -90rpx;
  background: rgba(255, 255, 255, 0.1);
}
.b3 {
  width: 90rpx;
  height: 90rpx;
  left: 60rpx;
  bottom: 30rpx;
  background: rgba(255, 255, 255, 0.08);
}
.hero-body {
  position: relative;
  z-index: 2;
  padding: 40rpx 40rpx 0;
}
.hero-tag {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}
.hero-title {
  margin-top: 18rpx;
  font-size: 54rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: -1rpx;
  line-height: 1.14;
  display: flex;
  flex-direction: column;
}
.hero-title-2 {
  opacity: 0.92;
}
.hero-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
}
.hero-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 30rpx;
}
.hero-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 76rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 600;
  transition: transform 0.18s ease;
}
.hero-ghost {
  height: 76rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  color: #fff;
  font-size: 26rpx;
  transition: transform 0.18s ease;
}
.hero-deco {
  position: absolute;
  right: 34rpx;
  bottom: 40rpx;
  width: 150rpx;
  height: 190rpx;
  z-index: 1;
}
.deco-card {
  position: absolute;
  width: 108rpx;
  height: 140rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.26);
  border: 2rpx solid rgba(255, 255, 255, 0.42);
  animation: breathe 5s ease-in-out infinite;
}
.d-a {
  right: 0;
  top: 0;
  transform: rotate(9deg);
}
.d-b {
  right: 46rpx;
  top: 34rpx;
  transform: rotate(-8deg);
  animation-delay: 0.8s;
  background: rgba(255, 255, 255, 0.16);
}

/* 快捷入口 */
.quick {
  display: flex;
  margin: 32rpx 24rpx 0;
  padding: 24rpx 8rpx;
  background: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--sh-1);
}
.q-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: transform 0.18s ease;
}
.q-ic {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.q-label {
  font-size: 23rpx;
  color: var(--ink-2);
  font-weight: 500;
}

/* 回到顶部（叠在购物车按钮上方） */
.top-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(330rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-2);
  z-index: 99;
  transition: transform 0.18s ease;
}

/* 悬浮购物车 */
.cart-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(210rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-2);
  z-index: 99;
  transition: transform 0.18s ease;
}

/* 分区标题 */
.sec-left {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}
.sec-hint {
  font-size: 22rpx;
  color: var(--ink-3);
}
.sort-chips {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.sort-chips .chip {
  height: 52rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
}

/* 灵感横滑 */
.insp-scroll {
  white-space: nowrap;
}
.insp-row {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx 4rpx;
}
.insp {
  width: 208rpx;
  flex-shrink: 0;
  border-radius: var(--r-md);
  overflow: hidden;
  background: #fff;
  box-shadow: var(--sh-1);
  transition: transform 0.18s ease;
}
.insp-img {
  display: block;
  width: 208rpx;
  height: 260rpx;
  background: #f2f1f3;
}
.insp-foot {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 16rpx;
}
.insp-num {
  font-size: 21rpx;
  color: var(--ink-3);
}

/* 商品栅格 */
.goods {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
  padding: 0 32rpx;
}
.g-card {
  width: 332rpx;
  background: #fff;
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: var(--sh-1);
  transition: transform 0.18s ease;
}
.g-imgwrap {
  position: relative;
}
.g-img {
  display: block;
  width: 332rpx;
  height: 332rpx;
  background: #f2f1f3;
}
.g-chip {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: var(--brand-ink);
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}
.g-body {
  padding: 20rpx 22rpx 22rpx;
}
.g-title {
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.4;
  min-height: 76rpx;
}
.g-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}
.g-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}
.g-price {
  font-size: 34rpx;
}
.g-add {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-wrap {
  padding: 0 32rpx;
}
.foot-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 56rpx 0 20rpx;
  font-size: 21rpx;
  color: var(--ink-4);
  letter-spacing: 1rpx;
}
.dot-sep {
  color: var(--ink-4);
}
