.banner-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.banner-btn {
  margin-top: 20rpx;
}
.center-tip {
  text-align: center;
  padding: 100rpx 0;
}
.goods {
  display: flex;
  align-items: center;
}
.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f0ee;
  flex-shrink: 0;
}
.goods-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}
.goods-title {
  font-size: 30rpx;
  font-weight: 500;
}
.goods-desc {
  margin: 8rpx 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.price-unit {
  font-size: 22rpx;
  font-weight: 400;
}
.price-origin {
  font-size: 22rpx;
  color: #b8b0aa;
  text-decoration: line-through;
}
