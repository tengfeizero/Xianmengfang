/* 购物车 */
.addr {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 24rpx 32rpx 0;
  padding: 26rpx 28rpx;
  background: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--sh-1);
  transition: transform 0.18s ease;
}
.addr-ic {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #e8f8f4;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.addr-name {
  font-size: 29rpx;
  font-weight: 600;
}
.addr-full {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.c-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 0 32rpx 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--sh-1);
}
.cb {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #ded9ea;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
}
.cb.on {
  background: var(--grad);
  border-color: transparent;
}
.c-thumb {
  position: relative;
  width: 152rpx;
  height: 152rpx;
  border-radius: var(--r-md);
  overflow: hidden;
  flex-shrink: 0;
}
.c-img {
  width: 100%;
  height: 100%;
  background: #f1eef8;
}
.c-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--ink-4);
}
.c-custom {
  position: absolute;
  left: 0;
  bottom: 0;
  right: 0;
  height: 44rpx;
  background: linear-gradient(180deg, rgba(25, 22, 36, 0) 0%, rgba(25, 22, 36, 0.55) 100%);
  color: #fff;
  font-size: 19rpx;
  display: flex;
  align-items: flex-end;
  padding: 0 12rpx 6rpx;
}
.c-title {
  font-size: 28rpx;
  font-weight: 600;
}
.c-title.invalid {
  color: var(--ink-4);
  text-decoration: line-through;
}
.c-warn {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #f59f00;
}
.c-del {
  padding: 8rpx;
}
.qty {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: var(--bg);
  border-radius: 999rpx;
  padding: 6rpx;
}
.q-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--ink-2);
  box-shadow: 0 2rpx 8rpx rgba(25, 22, 36, 0.08);
  transition: transform 0.18s ease;
}
.q-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
}
.hint {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-4);
  padding: 16rpx 0 8rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(25, 22, 36, 0.05);
  z-index: 100;
}
.all {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 25rpx;
  color: var(--ink-2);
}
.f-total {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.f-price {
  font-size: 38rpx;
}
.f-btn {
  min-width: 220rpx;
  height: 84rpx;
}
