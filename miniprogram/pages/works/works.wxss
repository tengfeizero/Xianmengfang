/* 顶部：广场入口 + 积分 */
.top-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx 0;
}
.plaza-entry {
  position: relative;
  flex: 1;
  background: linear-gradient(135deg, #ffe3ea 0%, #fff3f6 100%);
  border-radius: 16rpx;
  padding: 22rpx 60rpx 22rpx 24rpx;
}
.plaza-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #d63a58;
}
.plaza-sub {
  display: block;
  font-size: 22rpx;
  color: #b5798a;
  margin-top: 6rpx;
}
.plaza-arrow {
  position: absolute;
  right: 22rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #e08ea0;
}
.points-chip {
  flex-shrink: 0;
  background: #fff;
  border: 1rpx solid #ffd7e1;
  color: #d63a58;
  font-size: 24rpx;
  border-radius: 30rpx;
  padding: 12rpx 20rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 20rpx;
}
.work-item {
  position: relative;
  width: 345rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.work-img {
  display: block;
  width: 345rpx;
  height: 400rpx;
  background: #f5f0ee;
}
.badge {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 22rpx;
}
.badge.on {
  background: rgba(255, 122, 152, 0.92);
}

.meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 16rpx 0;
}
.stat {
  font-size: 22rpx;
  color: #999;
}
.del {
  margin-left: auto;
  font-size: 22rpx;
  color: #c9c2c4;
}

.prompt {
  padding: 8rpx 16rpx 16rpx;
  font-size: 22rpx;
  color: #777;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
