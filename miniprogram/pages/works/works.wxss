/* 作品：创作者条 + 数据带 + 筛选 + 作品网格 */
.creator {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 24rpx 32rpx 0;
  padding: 28rpx;
  background: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--sh-1);
}
.cava {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: var(--grad);
  flex-shrink: 0;
}
.cava-fb {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
}
.points {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--gold-soft);
  transition: transform 0.18s ease;
}
.points text {
  color: #a86b00;
  font-size: 26rpx;
  font-weight: 700;
}

.stats {
  display: flex;
  align-items: center;
  margin: 20rpx 32rpx 0;
  padding: 26rpx 0;
  background: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--sh-1);
}
.st {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.st-n {
  font-size: 36rpx;
  font-weight: 700;
}
.st-t {
  font-size: 22rpx;
  color: var(--ink-3);
}
.st-line {
  width: 2rpx;
  height: 48rpx;
  background: var(--line);
}

.filters {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 28rpx 32rpx 0;
}
.go-plaza {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-ink);
  font-size: 24rpx;
  font-weight: 600;
  transition: transform 0.18s ease;
}

/* 回到顶部 */
.top-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(210rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-2);
  z-index: 99;
  transition: transform 0.18s ease;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
  padding: 22rpx 32rpx 0;
}
.wcard {
  width: 332rpx;
  background: #fff;
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: var(--sh-1);
  transition: transform 0.18s ease;
}
.wcover {
  position: relative;
}
.wimg {
  display: block;
  width: 332rpx;
  height: 400rpx;
  background: #f2f1f3;
}
.badge {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(26, 26, 29, 0.5);
  backdrop-filter: blur(10rpx);
  color: #fff;
  font-size: 21rpx;
}
.badge.on {
  background: rgba(242, 69, 95, 0.92);
}
.badge text {
  color: #fff;
}
.wbody {
  padding: 20rpx 22rpx 22rpx;
}
.wprompt {
  font-size: 24rpx;
  color: var(--ink);
  line-height: 1.5;
  height: 72rpx;
}
.wmeta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
}
.m {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.m text {
  font-size: 22rpx;
  color: var(--ink-3);
}
.del {
  padding: 8rpx;
}
