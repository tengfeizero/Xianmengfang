<view class="page page-tab">

  <!-- 筛选 -->
  <view class="filters">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="chip chip-line {{filterKey === item.key ? 'on' : ''}}"
      data-key="{{item.key}}"
      bindtap="pickFilter"
    >{{item.label}}</view>
    <view class="grow"></view>
  </view>

  <x-skeleton wx:if="{{loading}}" type="grid" count="4" />

  <x-empty
    wx:elif="{{!shown.length}}"
    icon="grid"
    text="{{filterKey === 'all' ? '还没有作品，去创作第一个吧' : '这个分类下还没有作品'}}"
    desc="AI 生图或拼装工坊都能做出来"
    action-text="去创作"
    bind:action="goStudio"
  />

  <!-- 作品网格 -->
  <view wx:else class="grid">
    <view class="wcard rise" wx:for="{{shown}}" wx:key="id" hover-class="press-soft" data-id="{{item.id}}" bindtap="goWork">
      <view class="wcover">
        <image class="wimg" src="{{item.cover}}" mode="aspectFill" lazy-load data-id="{{item.id}}" catchtap="preview" />
        <view class="badge {{item.isPublic ? 'on' : ''}}" data-id="{{item.id}}" catchtap="togglePublish">
          <x-icon name="{{item.isPublic ? 'eye' : 'lock'}}" size="22" color="{{item.isPublic ? '#ffffff' : '#ffffff'}}" />
          <text>{{item.isPublic ? '公开中' : '私密'}}</text>
        </view>
      </view>
      <view class="wbody">
        <view class="wprompt ell2">{{item.prompt || item.typeText}}</view>
        <view class="wmeta">
          <view class="m">
            <x-icon name="heart" size="24" color="#9a99a2" />
            <text class="num">{{item.likeCount}}</text>
          </view>
          <view class="m">
            <x-icon name="package" size="24" color="#9a99a2" />
            <text class="num">{{item.useCount}}</text>
          </view>
          <view class="grow"></view>
          <view class="del" data-id="{{item.id}}" catchtap="del">
            <x-icon name="trash" size="26" color="#c5c4cb" />
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 回到顶部 -->
  <view wx:if="{{showTop}}" class="top-fab" hover-class="press" bindtap="goTop">
    <x-icon name="up" size="40" color="#5c5b62" />
  </view>
</view>
