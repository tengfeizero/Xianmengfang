<empty-state
  wx:if="{{!works.length}}"
  loading="{{loading}}"
  text="还没有作品，去创作第一个吧"
  action-text="去创作"
  bind:action="goStudio"
/>

<view class="grid">
  <view class="work-item" wx:for="{{works}}" wx:key="id">
    <image class="work-img" src="{{item.cover}}" mode="aspectFill" data-id="{{item.id}}" bindtap="preview" />
    <view class="work-del" data-id="{{item.id}}" catchtap="del">删</view>
  </view>
</view>
