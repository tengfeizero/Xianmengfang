.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 220rpx;
}
.logo-wrap {
  margin-bottom: 120rpx;
  text-align: center;
}
.logo {
  font-size: 72rpx;
  font-weight: 700;
  color: #ff7ea0;
  letter-spacing: 8rpx;
}
.slogan {
  margin-top: 16rpx;
  color: #999;
  font-size: 28rpx;
}
.login-btn {
  width: 560rpx;
}
.dev-box {
  margin-top: 80rpx;
  width: 560rpx;
  text-align: center;
}
.dev-input {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin: 24rpx 0;
  background: #fff;
}
