/* 登录 */
.login {
  min-height: 100vh;
  background: linear-gradient(180deg, #f4f1ff 0%, #f7f5fb 46%);
  display: flex;
  flex-direction: column;
}
.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 60rpx;
  overflow: hidden;
}
.logo {
  position: relative;
  z-index: 2;
  width: 156rpx;
  height: 156rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #7a5cff 0%, #ff6fa5 100%);
  color: #fff;
  font-size: 72rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-brand);
  animation: breathe 4s ease-in-out infinite;
}
.h-name {
  position: relative;
  z-index: 2;
  margin-top: 32rpx;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.slogan {
  position: relative;
  z-index: 2;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 6rpx;
}
.hero .blob {
  opacity: 0.5;
}
.b1 {
  width: 320rpx;
  height: 320rpx;
  left: -110rpx;
  top: -80rpx;
  background: rgba(122, 92, 255, 0.14);
}
.b2 {
  width: 240rpx;
  height: 240rpx;
  right: -90rpx;
  top: 120rpx;
  background: rgba(255, 111, 165, 0.12);
}
.b3 {
  width: 140rpx;
  height: 140rpx;
  left: 90rpx;
  top: 340rpx;
  background: rgba(122, 92, 255, 0.1);
}

.feats {
  margin: 20rpx 48rpx 0;
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}
.feat {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: #fff;
  border-radius: var(--r-lg);
  padding: 26rpx 28rpx;
  box-shadow: var(--sh-1);
}
.f-ic {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.f-t {
  font-size: 28rpx;
  font-weight: 600;
}

.login-btn {
  margin: 60rpx 48rpx 0;
}
.agree {
  text-align: center;
  margin-top: 22rpx;
}
.dev-box {
  margin: 60rpx 48rpx 0;
}
.dev-input {
  margin: 24rpx 0;
  height: 88rpx;
  border-radius: var(--r-md);
  background: var(--bg);
  padding: 0 28rpx;
  font-size: 27rpx;
}
.dev-ph {
  color: var(--ink-4);
}
